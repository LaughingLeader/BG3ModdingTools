{
	"bg3createuuid": {
		"prefix": "bg3uuid",
		"description": "Generates a random version 4 UUID",
		"scope": "xml",
		"body": [
			"${UUID}"
		]
	},
	"bg3createhandle": {
		"prefix": "bg3handle",
		"description": "Generates a random localization UUID, used in files such as english.xml, StringKeyFile.lsb, root templates, character creation presets, etc.",
		"scope": "xml,tsv,csv",
		"body": [
			"h${UUID/[-]/g/g}"
		]
	},
	"bg3version1": {
		"prefix": "bg3version1",
		"description": "The Int64 value for 1.0.0.0. Good starting point for mods.",
		"scope": "xml",
		"body": [
			"36028797018963968"
		]
	},
	"bg3dependency": {
		"prefix": "bg3dependency",
		"description": "Goes under the Dependencies node in a meta.lsx, or can be used for entries under the Mods node in modsettings.lsx.",
		"scope": "xml",
		"body": [
			"<node id=\"ModuleShortDesc\">",
			"\t<attribute id=\"Folder\" type=\"LSString\" value=\"${1:ModDirectory}_${2:ModUUID}\" />",
			"\t<attribute id=\"MD5\" type=\"LSString\" value=\"\" />",
			"\t<attribute id=\"Name\" type=\"LSString\" value=\"${3:ModName}\" />",
			"\t<attribute id=\"PublishHandle\" type=\"uint64\" value=\"0\" />",
			"\t<attribute id=\"UUID\" type=\"guid\" value=\"${2:ModUUID}\" />",
			"\t<attribute id=\"Version64\" type=\"int64\" value=\"${4:36028797018963968}\" />",
			"</node>",
		]
	},
